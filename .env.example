# Telegram Bot Token (get in @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpassword
POSTGRES_DB=medbot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (FSM Storage)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Data encryption
ENCRYPTION_KEY=your_fernet_key_here

# Webhook
WEBHOOK_HOST=your_server_ip
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_secret_key
WEBHOOK_PORT=8443
WEBHOOK_DROP_PENDING_UPDATES=false

# Bucket
BACKUP_S3_BUCKET=<bucket_name>
BACKUP_S3_ENDPOINT_URL=your_url
BACKUP_S3_ACCESS_KEY=<Access Key>
BACKUP_S3_SECRET_KEY=<Secret Key>
BACKUP_S3_REGION=your_server
BACKUP_RETENTION_DAYS=14

# Feedback
ADMIN_CHAT_ID=<your_telegram_id>

# Admin auth
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD_HASH=your_hash
ADMIN_PANEL_SESSION_SECRET=your_secret_session

# /api/sync auth
SYNC_SECRET=your_sync_secret
